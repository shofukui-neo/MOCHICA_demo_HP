---
import { siteConfig } from '../config';

// 3サイトは完全に独立しているため、他サイトへのナビゲーションは持たない。
// ヘッダーはロゴ（自サイトのルート）と、同一ページ内のエントリーセクションへの導線のみ。
// 表示される文言・ロゴ画像はすべて src/config/site.config.ts の header / brand から供給される。
const { header, brand } = siteConfig;
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent transition-all duration-300"
  data-state="top"
>
  <div class="shell flex items-center justify-between py-3.5">
    <a href={header.homeHref} class="flex items-center gap-2.5" aria-label={header.homeAriaLabel}>
      <img
        src={brand.logo.src}
        alt={brand.logo.alt}
        width="32"
        height="32"
        class="h-8 w-8 rounded-lg"
        loading="eager"
      />
      <span class="flex flex-col leading-none">
        <span id="brand-word" class="text-[15px] font-black tracking-tight transition-colors"
          >{header.brandName}</span
        >
        <span id="brand-sub" class="mt-0.5 text-[9px] font-bold tracking-[0.2em] transition-colors"
          >{header.brandSub}</span
        >
      </span>
    </a>

    <a href={header.cta.href} class="btn-primary px-6 py-2.5 text-xs">{header.cta.label}</a>
  </div>
</header>

<style>
  /* トップ位置：ヒーロー写真に重なるので白抜き */
  #site-header[data-state='top'] {
    background: transparent;
  }
  #site-header[data-state='top'] :global(#brand-word),
  #site-header[data-state='top'] :global(#brand-sub) {
    color: #ffffff;
  }

  /* スクロール後：白背景に反転 */
  #site-header[data-state='scrolled'] {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border-bottom-color: #e5e7eb;
  }
  #site-header[data-state='scrolled'] :global(#brand-word) {
    color: var(--color-brand-blue-deep);
  }
  #site-header[data-state='scrolled'] :global(#brand-sub) {
    color: var(--color-brand-blue);
  }
</style>

<script>
  const header = document.getElementById('site-header');

  const sync = () => {
    if (!header) return;
    header.dataset.state = window.scrollY > 24 ? 'scrolled' : 'top';
  };

  window.addEventListener('scroll', sync, { passive: true });
  sync();
</script>
