---
interface Props {
  employee: {
    name: string;
    initials: string;
    headline: string;
    joined: string;
    dept: string;
    accent: string;
  };
}
const { employee: e } = Astro.props;

const accentBg: Record<string, string> = {
  blue: 'bg-brand-blue',
  purple: 'bg-brand-purple',
  pink: 'bg-brand-pink',
  green: 'bg-brand-green',
};
---

<div class="card-lift flex flex-col p-6">
  <div class={`flex h-12 w-12 items-center justify-center rounded-xl text-sm font-black text-white ${accentBg[e.accent]}`}>
    {e.initials}
  </div>
  <p class="mt-4 text-sm font-bold text-ink">{e.name}</p>
  <p class="text-[11px] text-gray-500">{e.dept} / {e.joined}年入社</p>
  <p class="mt-3 flex-1 text-[13px] leading-relaxed text-gray-600">{e.headline}</p>
</div>
