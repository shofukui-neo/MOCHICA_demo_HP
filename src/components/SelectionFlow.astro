---
import SectionHeading from './SectionHeading.astro';
import type { SelectionFlowContent } from '../config/schema';

interface Props {
  content: SelectionFlowContent;
}

const { content } = Astro.props;
// 5ステップまでは1行に収め、それ以上は折り返す
const columns = Math.min(content.steps.length, 5);
---

<section id={content.id} class="bg-white py-20 md:py-28">
  <div class="shell">
    <SectionHeading content={content.heading} />

    <ol
      class="mt-14 grid gap-5 sm:grid-cols-2"
      style={`--flow-columns:${columns}`}
    >
      {
        content.steps.map((s, i) => (
          <li class="relative">
            <div class="card-lift h-full p-6">
              <span class="text-2xl font-black text-brand-blue-light">{s.step}</span>
              <h3 class="mt-1 text-sm font-bold text-ink">{s.title}</h3>
              <p class="mt-2 text-[12px] leading-relaxed text-gray-600">{s.body}</p>
            </div>
            {i < content.steps.length - 1 && (
              <span class="absolute -right-3.5 top-1/2 hidden -translate-y-1/2 text-gray-300 lg:block">
                ▶
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    ol {
      grid-template-columns: repeat(var(--flow-columns), minmax(0, 1fr));
    }
  }
</style>
