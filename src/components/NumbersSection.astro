---
import SectionHeading from './SectionHeading.astro';
import type { NumbersContent } from '../config/schema';

interface Props {
  content: NumbersContent;
}

const { content } = Astro.props;
---

<section id={content.id} class="bg-surface py-20 md:py-28">
  <div class="shell grid items-center gap-12 lg:grid-cols-[1fr_minmax(0,440px)]">
    <div>
      <SectionHeading content={content.heading} />

      <dl class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-4 lg:grid-cols-2">
        {
          content.facts.map((f) => (
            <div class="border-l-2 border-brand-blue pl-4">
              <dd class="flex items-baseline gap-1">
                <span class="text-3xl font-black text-ink md:text-4xl">{f.value}</span>
                {f.unit && <span class="text-sm font-bold text-brand-blue">{f.unit}</span>}
              </dd>
              <dt class="mt-1 text-xs font-bold text-gray-700">{f.label}</dt>
              {f.note && <p class="text-[11px] text-gray-400">{f.note}</p>}
            </div>
          ))
        }
      </dl>
    </div>

    <div class="media-frame aspect-[4/3] shadow-xl lg:aspect-[3/4]">
      <img src={content.image.src} alt={content.image.alt} loading="lazy" decoding="async" />
    </div>
  </div>
</section>
