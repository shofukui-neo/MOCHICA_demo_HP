---
import { VALUES, SITE, IMAGES } from '../data/site';
---

<section id="values" class="relative isolate overflow-hidden bg-brand-blue-deep py-20 md:py-28">
  <img
    src={IMAGES.statement}
    alt=""
    class="absolute inset-0 -z-20 h-full w-full object-cover opacity-25"
    loading="lazy"
    decoding="async"
  />
  <div class="grid-veil absolute inset-0 -z-10"></div>

  <div class="shell">
    <p class="section-label text-brand-blue-light/70">02 — Purpose</p>
    <h2 class="mt-4 text-2xl font-black leading-tight text-white md:text-4xl">
      {SITE.purpose}
    </h2>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-white/70 md:text-base">
      私たちが描く未来は、誰もが主体的に、いきいきと働ける社会。次世代が前向きに生きられる社会。
      そのために、一人ひとりに本気で向き合い、人の力をテクノロジーで加速させます。
    </p>

    <div class="mt-14">
      <p class="text-[11px] font-bold tracking-[0.25em] text-white/50">7 VALUES</p>
      <div class="mt-6 grid gap-px overflow-hidden rounded-2xl bg-white/15 sm:grid-cols-2 lg:grid-cols-3">
        {
          VALUES.map((v) => (
            <div class="group bg-brand-blue-deep/80 p-7 backdrop-blur transition hover:bg-brand-blue/30">
              <span class="text-[10px] font-black tracking-[0.2em] text-white/40">{v.no}</span>
              <h3 class="mt-2 text-base font-bold text-white">{v.title}</h3>
              <p class="mt-2.5 text-[13px] leading-relaxed text-white/65">{v.body}</p>
            </div>
          ))
        }
        <div class="flex items-center bg-brand-blue/25 p-7 backdrop-blur">
          <p class="text-sm font-bold leading-relaxed text-white/90">
            この7つに<br />ピンと来たなら、<br />たぶん合います。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
