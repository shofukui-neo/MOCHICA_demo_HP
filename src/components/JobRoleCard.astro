---
interface Props {
  role: {
    no: string;
    title: string;
    en: string;
    accent: string;
    image: string;
    catch: string;
    body: string;
    day: readonly { time: string; text: string }[];
    fit: readonly string[];
  };
  flip?: boolean;
}
const { role, flip = false } = Astro.props;

const accentText: Record<string, string> = {
  blue: 'text-brand-blue',
  purple: 'text-brand-purple',
  pink: 'text-brand-pink',
  orange: 'text-brand-orange',
};
const accentBg: Record<string, string> = {
  blue: 'bg-brand-blue',
  purple: 'bg-brand-purple',
  pink: 'bg-brand-pink',
  orange: 'bg-brand-orange',
};
const accentSoft: Record<string, string> = {
  blue: 'bg-brand-blue-light text-brand-blue',
  purple: 'bg-brand-purple-light text-brand-purple',
  pink: 'bg-brand-pink-light text-brand-pink',
  orange: 'bg-brand-orange-light text-brand-orange',
};
---

<article class="card-lift overflow-hidden">
  <div class="grid md:grid-cols-2">
    <div class:list={['media-frame aspect-[4/3] rounded-none md:aspect-auto md:min-h-[380px]', flip && 'md:order-2']}>
      <img src={role.image} alt={`${role.title}の仕事風景`} loading="lazy" decoding="async" />
      <span
        class={`absolute left-5 top-5 rounded-full px-3 py-1 text-[11px] font-black tracking-widest text-white ${accentBg[role.accent]}`}
      >
        {role.no}
      </span>
    </div>

    <div class:list={['flex flex-col p-7 md:p-10', flip && 'md:order-1']}>
      <p class={`text-[10px] font-bold tracking-[0.22em] ${accentText[role.accent]}`}>{role.en}</p>
      <h3 class="mt-2 text-xl font-bold text-ink md:text-2xl">{role.title}</h3>
      <p class={`mt-3 text-sm font-bold ${accentText[role.accent]}`}>{role.catch}</p>
      <p class="mt-4 text-sm leading-relaxed text-gray-600">{role.body}</p>

      <div class="mt-7 rounded-xl bg-surface-muted p-5">
        <p class="text-[10px] font-bold tracking-[0.2em] text-gray-500">A DAY IN THE LIFE</p>
        <ul class="mt-3 space-y-2.5">
          {
            role.day.map((d) => (
              <li class="flex gap-3 text-sm">
                <span class={`shrink-0 font-mono text-xs font-bold ${accentText[role.accent]}`}>
                  {d.time}
                </span>
                <span class="text-gray-700">{d.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-5">
        <p class="text-[10px] font-bold tracking-[0.2em] text-gray-500">こんな人に向いています</p>
        <ul class="mt-2.5 flex flex-wrap gap-2">
          {
            role.fit.map((f) => (
              <li class={`rounded-full px-3 py-1 text-[11px] font-bold ${accentSoft[role.accent]}`}>
                {f}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</article>
