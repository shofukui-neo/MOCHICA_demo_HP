---
const businesses = [
  {
    title: '中途採用支援',
    color: 'blue',
    description: '転職エージェント事業を中心に、企業と求職者の双方に向き合い、最適なマッチングを実現します。',
    icon: 'people',
  },
  {
    title: 'ヘルスケア',
    color: 'green',
    description: '看護・介護分野の人材支援を通じて、医療・福祉の現場と働く人々をつなぎます。',
    icon: 'health',
  },
  {
    title: '海外サービス',
    color: 'orange',
    description: 'グローバル人材の採用支援や海外進出支援など、国境を越えたキャリア支援を展開します。',
    icon: 'globe',
  },
];

const colorMap: Record<string, string> = {
  blue: 'bg-brand-blue-light border-blue-200',
  green: 'bg-brand-green-light border-green-200',
  orange: 'bg-brand-orange-light border-orange-200',
};
---

<section id="business" class="py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <p class="section-label mb-2">01 — BUSINESS</p>
    <h2 class="mb-10 text-2xl font-bold text-gray-900 md:text-3xl">結局、何をやってる会社？</h2>

    <div class="grid gap-6 md:grid-cols-3">
      {businesses.map((biz) => (
        <div class:list={['card overflow-hidden', colorMap[biz.color]]}>
          <div class="flex h-32 items-center justify-center">
            {biz.icon === 'people' && (
              <svg viewBox="0 0 80 60" class="h-16 w-20" aria-hidden="true">
                <circle cx="25" cy="18" r="10" fill="#2563eb"/>
                <circle cx="55" cy="18" r="10" fill="#3b82f6"/>
                <ellipse cx="25" cy="45" rx="18" ry="14" fill="#2563eb"/>
                <ellipse cx="55" cy="45" rx="18" ry="14" fill="#3b82f6"/>
              </svg>
            )}
            {biz.icon === 'health' && (
              <svg viewBox="0 0 80 60" class="h-16 w-20" aria-hidden="true">
                <circle cx="20" cy="18" r="8" fill="#16a34a"/>
                <circle cx="40" cy="15" r="9" fill="#22c55e"/>
                <circle cx="60" cy="18" r="8" fill="#15803d"/>
                <ellipse cx="20" cy="44" rx="14" ry="12" fill="#16a34a"/>
                <ellipse cx="40" cy="42" rx="16" ry="13" fill="#22c55e"/>
                <ellipse cx="60" cy="44" rx="14" ry="12" fill="#15803d"/>
              </svg>
            )}
            {biz.icon === 'globe' && (
              <svg viewBox="0 0 80 60" class="h-16 w-20" aria-hidden="true">
                <circle cx="40" cy="30" r="22" fill="none" stroke="#ea580c" stroke-width="3"/>
                <ellipse cx="40" cy="30" rx="10" ry="22" fill="none" stroke="#ea580c" stroke-width="2"/>
                <line x1="18" y1="30" x2="62" y2="30" stroke="#ea580c" stroke-width="2"/>
                <circle cx="55" cy="15" r="8" fill="#f59e0b"/>
              </svg>
            )}
          </div>
          <div class="bg-white p-6">
            <h3 class="mb-2 text-lg font-bold text-gray-900">{biz.title}</h3>
            <p class="text-sm text-gray-600">{biz.description}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-gray-500">
      100以上のパートナーサービスと連携し、多様なキャリア支援を提供しています。
    </p>
  </div>
</section>
