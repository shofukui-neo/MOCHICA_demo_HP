---
import { accentBg } from '../config';
import type { InterviewContent } from '../config/schema';

interface Props {
  employee: InterviewContent['others'][number];
  /** 入社年の後ろに付ける語（例: 年入社） */
  joinedSuffix: string;
}
const { employee: e, joinedSuffix } = Astro.props;
---

<div class="card-lift flex flex-col p-6">
  <div
    class={`flex h-12 w-12 items-center justify-center rounded-xl text-sm font-black text-white ${accentBg[e.accent]}`}
  >
    {e.initials}
  </div>
  <p class="mt-4 text-sm font-bold text-ink">{e.name}</p>
  <p class="text-[11px] text-gray-500">{e.department} / {e.joined}{joinedSuffix}</p>
  <p class="mt-3 flex-1 text-[13px] leading-relaxed text-gray-600">{e.headline}</p>
</div>
