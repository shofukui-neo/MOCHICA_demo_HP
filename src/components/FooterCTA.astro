---
interface Props {
  headline: string;
  linkPrimary?: { label: string; href: string };
  linkSecondary?: { label: string; href: string };
}

const { headline, linkPrimary, linkSecondary } = Astro.props;
---

<section id="entry" class="bg-brand-blue-light/40 py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-4 text-center md:px-6">
    <p class="section-label mb-2">ENTRY</p>
    <h2 class="mb-8 text-2xl font-bold leading-relaxed text-gray-900 md:text-3xl">{headline}</h2>

    <div class="mb-8 flex flex-wrap justify-center gap-4">
      <a href="#" class="btn-primary px-10 py-4 text-base">エントリーする</a>
      <a href="#" class="btn-secondary px-10 py-4 text-base">説明会を予約</a>
    </div>

    {(linkPrimary || linkSecondary) && (
      <div class="flex flex-wrap justify-center gap-6 text-sm">
        {linkPrimary && (
          <a href={linkPrimary.href} class="font-medium text-brand-blue hover:underline">
            {linkPrimary.label} →
          </a>
        )}
        {linkSecondary && (
          <a href={linkSecondary.href} class="font-medium text-brand-blue hover:underline">
            {linkSecondary.label} →
          </a>
        )}
      </div>
    )}
  </div>
</section>

<footer class="border-t border-gray-200 bg-white py-8">
  <div class="mx-auto max-w-6xl px-4 text-center md:px-6">
    <p class="text-sm font-bold text-brand-blue">NEO CAREER</p>
    <p class="mt-2 text-xs text-gray-500">© 2026 NEO CAREER Inc. All rights reserved.</p>
  </div>
</footer>
