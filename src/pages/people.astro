---
/**
 * 人を知る（people サイト）。
 * 文言・画像は一切ここには書かない。すべて src/config/site.config.ts の pages.people から供給される。
 * セクションを config から消せば、そのブロックは出力されない。
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ValuesSection from '../components/ValuesSection.astro';
import InterviewSection from '../components/InterviewSection.astro';
import CareerPath from '../components/CareerPath.astro';
import EntryCTA from '../components/EntryCTA.astro';
import { getPage, siteConfig } from '../config';

const page = getPage('people');
const entry = page.entry ?? siteConfig.entry;
---

<Layout meta={page.meta} siteId="people">
  <PageHero content={page.hero} />

  {page.values && <ValuesSection content={page.values} />}
  {page.interview && <InterviewSection content={page.interview} />}
  {page.careerPath && <CareerPath content={page.careerPath} />}

  <EntryCTA content={entry} />
</Layout>
