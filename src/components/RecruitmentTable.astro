---
const rows = [
  { label: '職種', value: '法人営業 / キャリアアドバイザー / 企画・マーケティング / 新規事業・HR Tech' },
  { label: '初任給', value: '（要ヒアリング）月給25万円〜' },
  { label: '勤務地', value: '（要ヒアリング）東京本社' },
  { label: '勤務時間', value: '（要ヒアリング）9:00〜18:00（所定労働時間8時間）' },
  { label: '休日休暇', value: '（要ヒアリング）完全週休2日制、年間休日120日以上' },
  { label: '福利厚生', value: '（要ヒアリング）社会保険完備、交通費全額支給、各種手当' },
];
---

<section class="bg-surface-muted py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-4 md:px-6">
    <h2 class="mb-8 text-2xl font-bold text-gray-900">募集要項</h2>
    <table class="w-full border-collapse text-sm">
      <tbody>
        {rows.map((row) => (
          <tr class="border-b border-gray-200">
            <th class="w-1/3 py-4 pr-4 text-left font-semibold text-gray-600">{row.label}</th>
            <td class="py-4 text-gray-800">{row.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
