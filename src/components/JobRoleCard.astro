---
import { accentBg, accentChip, accentText } from '../config';
import type { JobRolesContent } from '../config/schema';

interface Props {
  role: JobRolesContent['items'][number];
  /** 「1日の流れ」ブロックの見出し */
  dayLabel: string;
  /** 「向いている人」ブロックの見出し */
  fitLabel: string;
  /** true で画像を右側に配置（交互レイアウト用） */
  flip?: boolean;
}
const { role, dayLabel, fitLabel, flip = false } = Astro.props;
---

<article class="card-lift overflow-hidden">
  <div class="grid md:grid-cols-2">
    <div
      class:list={[
        'media-frame aspect-[4/3] rounded-none md:aspect-auto md:min-h-[380px]',
        flip && 'md:order-2',
      ]}
    >
      <img src={role.image.src} alt={role.image.alt} loading="lazy" decoding="async" />
      <span
        class={`absolute left-5 top-5 rounded-full px-3 py-1 text-[11px] font-black tracking-widest text-white ${accentBg[role.accent]}`}
      >
        {role.no}
      </span>
    </div>

    <div class:list={['flex flex-col p-7 md:p-10', flip && 'md:order-1']}>
      <p class={`text-[10px] font-bold tracking-[0.22em] ${accentText[role.accent]}`}>{role.en}</p>
      <h3 class="mt-2 text-xl font-bold text-ink md:text-2xl">{role.title}</h3>
      <p class={`mt-3 text-sm font-bold ${accentText[role.accent]}`}>{role.catch}</p>
      <p class="mt-4 text-sm leading-relaxed text-gray-600">{role.body}</p>

      {
        role.day.length > 0 && (
          <div class="mt-7 rounded-xl bg-surface-muted p-5">
            <p class="text-[10px] font-bold tracking-[0.2em] text-gray-500">{dayLabel}</p>
            <ul class="mt-3 space-y-2.5">
              {role.day.map((d) => (
                <li class="flex gap-3 text-sm">
                  <span class={`shrink-0 font-mono text-xs font-bold ${accentText[role.accent]}`}>
                    {d.time}
                  </span>
                  <span class="text-gray-700">{d.text}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        role.fit.length > 0 && (
          <div class="mt-5">
            <p class="text-[10px] font-bold tracking-[0.2em] text-gray-500">{fitLabel}</p>
            <ul class="mt-2.5 flex flex-wrap gap-2">
              {role.fit.map((f) => (
                <li class={`rounded-full px-3 py-1 text-[11px] font-bold ${accentChip[role.accent]}`}>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</article>
