---
import SectionHeading from './SectionHeading.astro';
import { REQUIREMENTS } from '../data/site';
---

<section id="requirements" class="bg-surface-muted py-20 md:py-28">
  <div class="shell">
    <SectionHeading label="03 — Requirements" title="募集要項" />

    <dl class="mt-12 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      {
        REQUIREMENTS.map((r, i) => (
          <div
            class:list={[
              'grid gap-1 px-6 py-5 sm:grid-cols-[200px_1fr] sm:gap-6 sm:px-8',
              i > 0 && 'border-t border-gray-100',
            ]}
          >
            <dt class="text-xs font-bold tracking-wider text-brand-blue">{r.label}</dt>
            <dd class="text-sm leading-relaxed text-gray-700">{r.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-5 text-xs text-gray-500">
      ※ 本ページはデモサイトです。実際の募集内容は公式採用ページをご確認ください。
    </p>
  </div>
</section>
