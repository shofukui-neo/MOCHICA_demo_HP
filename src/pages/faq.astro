---
/**
 * 選考を知る（faq サイト）。
 * 文言・画像は一切ここには書かない。すべて src/config/site.config.ts の pages.faq から供給される。
 * セクションを config から消せば、そのブロックは出力されない。
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SelectionFlow from '../components/SelectionFlow.astro';
import RecruitmentTable from '../components/RecruitmentTable.astro';
import FAQSection from '../components/FAQSection.astro';
import EntryCTA from '../components/EntryCTA.astro';
import { getPage, siteConfig } from '../config';

const page = getPage('faq');
const entry = page.entry ?? siteConfig.entry;
---

<Layout meta={page.meta} siteId="faq">
  <PageHero content={page.hero} />

  {page.flow && <SelectionFlow content={page.flow} />}
  {page.requirements && <RecruitmentTable content={page.requirements} />}
  {page.faq && <FAQSection content={page.faq} />}

  <EntryCTA content={entry} />
</Layout>
