---
import SectionHeading from './SectionHeading.astro';
import type { FaqContent } from '../config/schema';

interface Props {
  content: FaqContent;
}

const { content } = Astro.props;
---

<section id={content.id} class="bg-white py-20 md:py-28">
  <div class="shell">
    <SectionHeading content={content.heading} />

    <div class="mt-14 space-y-12">
      {
        content.groups.map((group) => (
          <div>
            <h3 class="flex items-center gap-3 text-sm font-black text-ink">
              <span class="h-4 w-1 rounded-full bg-brand-blue" />
              {group.category}
            </h3>
            <div class="mt-5 space-y-3">
              {group.items.map((item) => (
                <details class="card group overflow-hidden">
                  <summary class="flex items-center justify-between gap-4 px-6 py-5 transition hover:bg-surface">
                    <span class="text-sm font-bold text-ink">
                      <span class="mr-2 font-black text-brand-blue">{content.questionPrefix}</span>
                      {item.q}
                    </span>
                    <span class="faq-chevron shrink-0 text-lg font-light text-brand-blue transition-transform duration-300">
                      +
                    </span>
                  </summary>
                  <div class="border-t border-gray-100 bg-surface/60 px-6 py-5">
                    <p class="text-[13px] leading-relaxed text-gray-700">
                      <span class="mr-2 font-black text-gray-400">{content.answerPrefix}</span>
                      {item.a}
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
