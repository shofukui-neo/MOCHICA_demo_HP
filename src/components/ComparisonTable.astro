---
import SectionHeading from './SectionHeading.astro';
import { accentText } from '../config';
import type { ComparisonContent } from '../config/schema';

interface Props {
  content: ComparisonContent;
}

const { content } = Astro.props;
// 横スクロールの下限幅を列数から決める（列が増えても潰れないようにする）
const minWidth = 160 + content.columns.length * 140;
---

<section id={content.id} class="bg-surface-muted py-20 md:py-28">
  <div class="shell">
    <SectionHeading content={content.heading} />

    <div class="mt-12 overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-sm">
      <table class="w-full border-collapse text-sm" style={`min-width:${minWidth}px`}>
        <thead>
          <tr class="border-b border-gray-200 bg-white">
            <th class="w-40 px-5 py-4 text-left text-xs font-bold tracking-wider text-gray-400">
              {content.axisLabel}
            </th>
            {
              content.columns.map((c) => (
                <th class={`px-5 py-4 text-left text-sm font-bold ${accentText[c.accent]}`}>
                  {c.label}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            content.rows.map((row, i) => (
              <tr class:list={['border-b border-gray-100', i % 2 === 1 && 'bg-surface/60']}>
                <th class="px-5 py-4 text-left text-xs font-bold text-gray-500">{row.axis}</th>
                {content.columns.map((_, col) => (
                  <td class="px-5 py-4 text-gray-700">{row.values[col] ?? ''}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
