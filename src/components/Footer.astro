---
import { formatAddress, siteConfig } from '../config';

// 3サイトは完全に独立しているため、サイトマップ（他サイトへのリンク）は持たない。
// 表示内容はすべて src/config/site.config.ts の brand / footer から供給される。
const { brand, footer } = siteConfig;
const address = formatAddress();
---

<footer class="bg-brand-blue-deep py-14 text-white/70">
  <div class="shell">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <div class="flex items-center gap-2.5">
          <img
            src={brand.logo.src}
            alt={brand.logo.alt}
            width="32"
            height="32"
            class="h-8 w-8 rounded-lg"
            loading="lazy"
          />
          <span class="text-[15px] font-black text-white">{brand.name}</span>
        </div>
        <p class="mt-4 text-[13px] font-bold text-white/90">{brand.purpose}</p>
        <p class="mt-3 text-xs leading-relaxed">
          {brand.company}<br />
          {address}
        </p>
      </div>

      {
        footer.links.length > 0 && (
          <ul class="flex flex-col gap-3">
            {footer.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm transition hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="mt-12 border-t border-white/15 pt-6">
      {
        footer.notes.map((note, i) => (
          <p class:list={['text-[11px] text-white/45', i > 0 && 'mt-2']}>{note}</p>
        ))
      }
      <p class:list={['text-[11px] text-white/45', footer.notes.length > 0 && 'mt-2']}>
        {footer.copyright}
      </p>
    </div>
  </div>
</footer>
