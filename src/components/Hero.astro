---
interface Props {
  subtitle?: string;
  variant?: 'default' | 'people' | 'faq';
}

const { subtitle, variant = 'default' } = Astro.props;

const subtitles: Record<string, string> = {
  default: '「人」と向き合い、未来を切り拓く。',
  people: 'ネオキャリアの"人"を、まるごと見せます。',
  faq: '聞きにくいことも、全部答えます。',
};

const displaySubtitle = subtitle ?? subtitles[variant];
---

<section class="relative overflow-hidden bg-brand-blue-light/60">
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div class="order-2 md:order-1">
        <p class="mb-3 text-xs font-bold tracking-widest text-brand-blue">2027 NEW GRADUATE</p>
        <h1 class="mb-4 text-3xl font-bold leading-tight text-gray-900 md:text-4xl lg:text-5xl">
          人と本気で向き合い、<br />未来を切り拓く。
        </h1>
        <p class="mb-8 text-base text-gray-600 md:text-lg">{displaySubtitle}</p>
        <div class="flex flex-wrap gap-4">
          <a href="#entry" class="btn-primary">エントリーする</a>
          <a href="#entry" class="btn-secondary">説明会を予約</a>
        </div>
      </div>

      <div class="order-1 flex justify-center md:order-2">
        {variant === 'faq' ? (
          <svg viewBox="0 0 320 200" class="h-48 w-full max-w-md md:h-56" aria-hidden="true">
            <rect width="320" height="200" rx="16" fill="#dbeafe"/>
            <circle cx="120" cy="100" r="40" fill="#2563eb" opacity="0.8"/>
            <circle cx="200" cy="100" r="40" fill="#1d4ed8" opacity="0.6"/>
            <rect x="140" y="60" width="40" height="30" rx="8" fill="white"/>
            <text x="160" y="82" text-anchor="middle" fill="#2563eb" font-size="24" font-weight="bold">?</text>
          </svg>
        ) : (
          <svg viewBox="0 0 320 200" class="h-48 w-full max-w-md md:h-56" aria-hidden="true">
            <rect width="320" height="200" rx="16" fill="#dbeafe"/>
            <ellipse cx="80" cy="130" rx="35" ry="50" fill="#2563eb"/>
            <ellipse cx="130" cy="120" rx="30" ry="45" fill="#3b82f6"/>
            <ellipse cx="190" cy="125" rx="32" ry="48" fill="#1d4ed8"/>
            <ellipse cx="240" cy="130" rx="28" ry="42" fill="#60a5fa"/>
            <circle cx="80" cy="70" r="22" fill="#2563eb"/>
            <circle cx="130" cy="65" r="20" fill="#3b82f6"/>
            <circle cx="190" cy="68" r="21" fill="#1d4ed8"/>
            <circle cx="240" cy="72" r="18" fill="#60a5fa"/>
          </svg>
        )}
      </div>
    </div>
  </div>
</section>
