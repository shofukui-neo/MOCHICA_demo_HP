---
import type { EntryContent } from '../config/schema';

interface Props {
  content: EntryContent;
}

const { content } = Astro.props;
const { form } = content;

// フォームブロックのアンカーID。config の primary.href をここに合わせる。
const formId = `${content.id}-form`;
// action が指定されているときだけ実際に送信できるフォームになる。
const isLive = Boolean(form?.action);
---

<section
  id={content.id}
  class="relative isolate overflow-hidden bg-brand-blue-deep py-20 md:py-28"
>
  <img
    src={content.image.src}
    alt={content.image.alt}
    class="absolute inset-0 -z-20 h-full w-full object-cover opacity-30"
    loading="lazy"
    decoding="async"
  />
  <div class="grid-veil absolute inset-0 -z-10"></div>

  <div class="shell text-center">
    <p class="section-label text-brand-blue-light/70">{content.label}</p>
    <h2 class="mt-4 text-2xl font-black leading-tight text-white md:text-4xl">
      {
        content.titleLines.map((line, i) => (
          <>
            {i > 0 && <br class="sm:hidden" />}
            {line}
          </>
        ))
      }
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-white/75">{content.lead}</p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={content.primary.href} class="btn-primary">{content.primary.label}</a>
      {
        content.secondary && (
          <a href={content.secondary.href} class="btn-ghost-light">
            {content.secondary.label}
          </a>
        )
      }
    </div>

    {
      form && (
        <form
          id={formId}
          action={form.action}
          method={form.action ? (form.method ?? 'post') : undefined}
          class="mx-auto mt-14 max-w-xl rounded-2xl border border-white/20 bg-white/10 p-7 text-left backdrop-blur md:p-9"
        >
          <p class="text-[11px] font-black tracking-[0.2em] text-white/60">{form.badge}</p>
          <p class="mt-2 text-sm text-white/80">{form.note}</p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {form.fields.map((field) => (
              <label class="block">
                <span class="text-[11px] font-bold text-white/70">{field.label}</span>
                <input
                  type={field.type}
                  name={field.name}
                  placeholder={field.placeholder}
                  required={isLive && field.required}
                  disabled={!isLive}
                  class="mt-1.5 w-full rounded-lg border border-white/25 bg-white/10 px-4 py-2.5 text-sm text-white placeholder-white/40"
                />
              </label>
            ))}
          </div>

          <button
            type="submit"
            disabled={!isLive}
            class:list={[
              'mt-6 w-full rounded-full px-8 py-3.5 text-sm font-bold transition',
              isLive
                ? 'bg-white text-brand-blue-deep shadow-lg hover:-translate-y-0.5 hover:shadow-xl'
                : 'cursor-not-allowed bg-white/25 text-white/60',
            ]}
          >
            {form.submitLabel}
          </button>
        </form>
      )
    }
  </div>
</section>
