---
const roles = ['法人営業', 'キャリアアドバイザー', '企画/マーケ', '新規事業/HR Tech'];
const criteria = [
  { label: '主な顧客', values: ['法人企業', '転職希望者', '社内外ステークホルダー', 'スタートアップ・VC'] },
  { label: '成果指標', values: ['売上・受注数', '成約数・満足度', 'KPI達成率', '新規事業売上'] },
  { label: '1日の中心', values: ['商談・提案', '面談・カウンセリング', '企画・分析', '事業開発'] },
  { label: '必要スキル', values: ['提案・交渉力', '傾聴・共感力', '論理思考・分析力', '起業家精神'] },
  { label: '向いている人', values: ['数字で成果を出したい', '人の人生に関わりたい', '仕組みを作りたい', '0→1を経験したい'] },
];
---

<section class="bg-surface-muted py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <p class="section-label mb-2">03 — COMPARE</p>
    <h2 class="mb-10 text-2xl font-bold text-gray-900 md:text-3xl">4職種を横に並べて比べる</h2>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr>
            <th class="border border-gray-200 bg-white p-3 text-left font-semibold text-gray-500"></th>
            {roles.map((role, i) => (
              <th class:list={[
                'border border-gray-200 p-3 text-center font-bold',
                i === 0 ? 'bg-brand-green-light text-brand-green' :
                i === 1 ? 'bg-brand-purple-light text-brand-purple' :
                i === 2 ? 'bg-brand-pink-light text-brand-pink' :
                'bg-brand-orange-light text-brand-orange',
              ]}>
                {role}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {criteria.map((row) => (
            <tr>
              <td class="border border-gray-200 bg-white p-3 font-medium text-gray-600">{row.label}</td>
              {row.values.map((val) => (
                <td class="border border-gray-200 bg-white p-3 text-center text-gray-700">{val}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
