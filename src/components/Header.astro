---
interface Props {
  activeNav?: 'jobs' | 'people' | 'faq';
}

const { activeNav } = Astro.props;

const navItems = [
  { id: 'jobs', label: '仕事・配属', href: '/' },
  { id: 'people', label: '働く社員', href: '/people' },
  { id: 'faq', label: 'よくある質問', href: '/faq' },
] as const;
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 md:px-6">
    <a href="/" class="text-lg font-bold tracking-tight text-brand-blue">NEO CAREER</a>

    <nav class="hidden items-center gap-6 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-medium transition',
            activeNav === item.id ? 'text-brand-blue' : 'text-gray-600 hover:text-brand-blue',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a href="#entry" class="btn-primary px-5 py-2 text-xs md:text-sm">エントリー</a>
  </div>
</header>
