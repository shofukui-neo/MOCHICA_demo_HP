---
import type { ValuesContent } from '../config/schema';

interface Props {
  content: ValuesContent;
}

const { content } = Astro.props;
---

<section
  id={content.id}
  class="relative isolate overflow-hidden bg-brand-blue-deep py-20 md:py-28"
>
  <img
    src={content.image.src}
    alt={content.image.alt}
    class="absolute inset-0 -z-20 h-full w-full object-cover opacity-25"
    loading="lazy"
    decoding="async"
  />
  <div class="grid-veil absolute inset-0 -z-10"></div>

  <div class="shell">
    <p class="section-label text-brand-blue-light/70">{content.label}</p>
    <h2 class="mt-4 text-2xl font-black leading-tight text-white md:text-4xl">{content.title}</h2>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-white/70 md:text-base">{content.lead}</p>

    <div class="mt-14">
      <p class="text-[11px] font-bold tracking-[0.25em] text-white/50">{content.itemsLabel}</p>
      <div
        class="mt-6 grid gap-px overflow-hidden rounded-2xl bg-white/15 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          content.items.map((v) => (
            <div class="group bg-brand-blue-deep/80 p-7 backdrop-blur transition hover:bg-brand-blue/30">
              <span class="text-[10px] font-black tracking-[0.2em] text-white/40">{v.no}</span>
              <h3 class="mt-2 text-base font-bold text-white">{v.title}</h3>
              <p class="mt-2.5 text-[13px] leading-relaxed text-white/65">{v.body}</p>
            </div>
          ))
        }
        {
          content.closingLines.length > 0 && (
            <div class="flex items-center bg-brand-blue/25 p-7 backdrop-blur">
              <p class="text-sm font-bold leading-relaxed text-white/90">
                {content.closingLines.map((line, i) => (
                  <>
                    {i > 0 && <br />}
                    {line}
                  </>
                ))}
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
