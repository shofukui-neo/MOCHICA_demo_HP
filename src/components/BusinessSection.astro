---
import SectionHeading from './SectionHeading.astro';
import { accentBg, accentChip, accentText } from '../config';
import type { BusinessContent } from '../config/schema';

interface Props {
  content: BusinessContent;
}

const { content } = Astro.props;
---

<section id={content.id} class="bg-white py-20 md:py-28">
  <div class="shell">
    <SectionHeading content={content.heading} />

    <div class="mt-14 grid gap-7 md:grid-cols-3">
      {
        content.items.map((biz) => (
          <article class="card-lift group flex flex-col overflow-hidden">
            <div class="media-frame aspect-[16/10] rounded-none">
              <img src={biz.image.src} alt={biz.image.alt} loading="lazy" decoding="async" />
            </div>
            <div class="flex flex-1 flex-col p-7">
              <div class="flex items-center gap-3">
                <span class={`h-8 w-1 rounded-full ${accentBg[biz.accent]}`} />
                <div>
                  <p class={`text-[10px] font-bold tracking-[0.2em] ${accentText[biz.accent]}`}>
                    {biz.no} / {biz.en}
                  </p>
                  <h3 class="text-lg font-bold text-ink">{biz.title}</h3>
                </div>
              </div>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-gray-600">{biz.description}</p>
              {biz.tags.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-2">
                  {biz.tags.map((t) => (
                    <li class={`rounded-full px-3 py-1 text-[11px] font-bold ${accentChip[biz.accent]}`}>
                      {t}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {content.note && <p class="mt-10 text-center text-xs text-gray-500">{content.note}</p>}
  </div>
</section>
