---
interface Props {
  number: string;
  title: string;
  subtitle: string;
  color: 'green' | 'purple' | 'pink' | 'orange';
  compact?: boolean;
}

const { number, title, subtitle, color, compact = false } = Astro.props;

const colorStyles: Record<string, { header: string; accent: string; light: string }> = {
  green: { header: 'bg-brand-green', accent: 'text-brand-green', light: 'bg-brand-green-light' },
  purple: { header: 'bg-brand-purple', accent: 'text-brand-purple', light: 'bg-brand-purple-light' },
  pink: { header: 'bg-brand-pink', accent: 'text-brand-pink', light: 'bg-brand-pink-light' },
  orange: { header: 'bg-brand-orange', accent: 'text-brand-orange', light: 'bg-brand-orange-light' },
};

const style = colorStyles[color];

const steps = ['ヒアリング', '提案', '課題解決'];
const timeline = [
  { time: '9:00', label: '出社・メールチェック' },
  { time: '10:00', label: 'クライアント訪問' },
  { time: '13:00', label: 'ランチ' },
  { time: '14:00', label: '提案資料作成' },
  { time: '17:00', label: 'チームMTG' },
  { time: '19:00', label: '退社' },
];

const skills = ['提案力', '交渉力', '課題解決力'];
const suitedFor = ['人と話すことが好き', '成果を数字で実感したい', 'チームで動くのが得意'];
const hardships = ['数字目標へのプレッシャー', '不確実な状況への対応', '長時間の商談'];
---

<article class="card overflow-hidden">
  <div class:list={['flex items-center gap-4 px-6 py-4 text-white', style.header]}>
    <span class="text-2xl font-bold opacity-80">{number}</span>
    <div>
      <h3 class="text-xl font-bold">{title}</h3>
      <p class="text-sm opacity-90">{subtitle}</p>
    </div>
    <svg viewBox="0 0 48 48" class="ml-auto h-12 w-12 opacity-80" aria-hidden="true">
      <circle cx="24" cy="16" r="10" fill="white" opacity="0.9"/>
      <ellipse cx="24" cy="40" rx="16" ry="12" fill="white" opacity="0.9"/>
    </svg>
  </div>

  {!compact && (
    <div class="p-6 space-y-6">
      <div>
        <p class="mb-3 text-xs font-semibold text-gray-500">仕事の流れ</p>
        <div class="flex items-center gap-2">
          {steps.map((step, i) => (
            <>
              <div class:list={['rounded-lg px-4 py-2 text-sm font-medium', style.light, style.accent]}>
                {step}
              </div>
              {i < steps.length - 1 && <span class="text-gray-400">→</span>}
            </>
          ))}
        </div>
      </div>

      <div>
        <p class="mb-3 text-xs font-semibold text-gray-500">1日の流れ</p>
        <div class="flex flex-wrap gap-2">
          {timeline.map((item) => (
            <div class="rounded-lg border border-gray-200 px-3 py-2 text-xs">
              <span class="font-bold text-gray-900">{item.time}</span>
              <span class="ml-1 text-gray-600">{item.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div>
        <p class="mb-3 text-xs font-semibold text-gray-500">身につくスキル</p>
        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => (
            <span class:list={['rounded-full px-4 py-1 text-sm font-medium', style.light, style.accent]}>
              {skill}
            </span>
          ))}
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <p class="mb-2 text-xs font-semibold text-gray-500">向いている人</p>
          <ul class="space-y-1 text-sm text-gray-700">
            {suitedFor.map((item) => (
              <li class="flex items-start gap-2">
                <span class:list={['mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full', style.header]} />
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl bg-brand-orange-light/60 p-4">
          <p class="mb-2 text-xs font-semibold text-brand-orange">大変なところ</p>
          <ul class="space-y-1 text-sm text-gray-700">
            {hardships.map((item) => (
              <li>・{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )}

  {compact && (
    <div class="p-6">
      <p class="text-sm text-gray-600">
        企画・マーケティングや新規事業・HR Techなど、会社の成長を牽引するポジション。データ分析や企画立案、新サービスの立ち上げに携わります。
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {['企画力', '分析力', '推進力'].map((skill) => (
          <span class:list={['rounded-full px-3 py-1 text-xs font-medium', style.light, style.accent]}>
            {skill}
          </span>
        ))}
      </div>
    </div>
  )}
</article>
