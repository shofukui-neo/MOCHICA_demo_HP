---
/**
 * 仕事を知る（jobs サイト）。
 * 文言・画像は一切ここには書かない。すべて src/config/site.config.ts の pages.jobs から供給される。
 * セクションを config から消せば、そのブロックは出力されない。
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import BusinessSection from '../components/BusinessSection.astro';
import NumbersSection from '../components/NumbersSection.astro';
import JobRolesSection from '../components/JobRolesSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import EntryCTA from '../components/EntryCTA.astro';
import { getPage, siteConfig } from '../config';

const page = getPage('jobs');
const entry = page.entry ?? siteConfig.entry;
---

<Layout meta={page.meta} siteId="jobs">
  <PageHero content={page.hero} />

  {page.business && <BusinessSection content={page.business} />}
  {page.numbers && <NumbersSection content={page.numbers} />}
  {page.jobRoles && <JobRolesSection content={page.jobRoles} />}
  {page.comparison && <ComparisonTable content={page.comparison} />}

  <EntryCTA content={entry} />
</Layout>
