---
import type { SectionHeadingContent } from '../config/schema';

interface Props {
  content: SectionHeadingContent;
  align?: 'left' | 'center';
}
const { content, align = 'left' } = Astro.props;
const { label, title, lead } = content;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  <p class="section-label">{label}</p>
  <h2 class="section-title mt-3">{title}</h2>
  {lead && <p class:list={['section-lead', align === 'center' && 'mx-auto']}>{lead}</p>}
</div>
