---
import SectionHeading from './SectionHeading.astro';
import type { CareerPathContent } from '../config/schema';

interface Props {
  content: CareerPathContent;
}

const { content } = Astro.props;
---

<section id={content.id} class="bg-white py-20 md:py-28">
  <div class="shell grid items-center gap-12 lg:grid-cols-2">
    <div>
      <SectionHeading content={content.heading} />

      <ol class="mt-10 space-y-6">
        {
          content.steps.map((step, i) => (
            <li class="relative flex gap-5 pl-1">
              <div class="flex flex-col items-center">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-blue text-xs font-black text-white">
                  {i + 1}
                </span>
                {i < content.steps.length - 1 && <span class="mt-2 w-px flex-1 bg-gray-200" />}
              </div>
              <div class="pb-2">
                <p class="text-[11px] font-black tracking-wider text-brand-blue">{step.phase}</p>
                <h3 class="mt-1 text-base font-bold text-ink">{step.title}</h3>
                <p class="mt-2 text-[13px] leading-relaxed text-gray-600">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="media-frame aspect-[4/5] shadow-xl">
      <img src={content.image.src} alt={content.image.alt} loading="lazy" decoding="async" />
    </div>
  </div>
</section>
